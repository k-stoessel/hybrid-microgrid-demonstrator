/ {
    zephyr,user {
        drdy-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>,  /* A2 */
                     <&gpiob 0 GPIO_ACTIVE_LOW>;  /* A3 */
        rst-gpios = <&gpioa 9 GPIO_ACTIVE_LOW>;
        pwms = <&pwm3 1 PWM_NSEC(100000) PWM_POLARITY_NORMAL>,
               <&pwm3 2 PWM_NSEC(100000) PWM_POLARITY_NORMAL>;
    };
};

&i2c3   { status = "disabled"; };   /* frees PA8 for MCO1 and PB4 for TIM3_CH1 */

/* Clock output on PA8. Not needed by the current ADC modules, which run
 * from their own 8.192 MHz crystals. */
&mco1 {
    clocks = <&rcc STM32_SRC_HSE MCO1_SEL(2)>;
    clock-names = "clksel";
    prescaler = <MCO1_PRE(MCO_PRE_DIV_1)>;
    pinctrl-0 = <&rcc_mco_1_pa8>;
    pinctrl-names = "default";
    status = "okay";
};

&spi1 {
    pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
    pinctrl-names = "default";
    cs-gpios = <&gpioa 0 GPIO_ACTIVE_LOW>,    /* A0 */
               <&gpioa 1 GPIO_ACTIVE_LOW>;    /* A1 */
    status = "okay";

    ads0: spi-dev@0 {
        compatible = "ads131m08";
        reg = <0>;
        spi-max-frequency = <4000000>;
    };

    ads1: spi-dev@1 {
        compatible = "ads131m08";
        reg = <1>;
        spi-max-frequency = <4000000>;
    };
};

&timers3 {
    st,prescaler = <0>;
    status = "okay";

    pwm3: pwm {
        pinctrl-0 = <&tim3_ch1_pb4 &tim3_ch2_pb5>;    /* D5, D4 */
        pinctrl-names = "default";
        status = "okay";
    };
};

&usart1 {
    current-speed = <921600>;
};

&timers2 { status = "disabled"; };
&pwm2    { status = "disabled"; };